{
  "name": "@spear-ai/npm-package-json-lint-config",
  "version": "4.0.0",
  "description": "Spear AI `npm-package-json-lint` config files",
  "license": "MIT",
  "author": {
    "name": "Spear AI",
    "email": "org@spear.ai",
    "url": "https://spear.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spear-ai/citizen.git",
    "directory": "packages/npm-package-json-lint-config"
  },
  "type": "module",
  "exports": {
    "./*": "./dist/*.cjs"
  },
  "scripts": {
    "build": "tsup src --cjsInterop --clean --splitting",
    "dev": "pnpm run build --watch",
    "npmpkgjsonlint:check": "npmPkgJsonLint --configFile dist/spear-library.cjs ."
  },
  "dependencies": {
    "npm-package-json-lint-config-default": "^10.0.0"
  },
  "devDependencies": {
    "npm-package-json-lint": "catalog:shared-dev",
    "tsup": "catalog:shared-dev",
    "typescript": "catalog:shared-dev"
  },
  "peerDependencies": {
    "npm-package-json-lint": "^11.0.0"
  }
}
