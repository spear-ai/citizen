{
  "name": "@spear-ai/eslint-config",
  "version": "21.1.0",
  "description": "Spear AI ESLint config",
  "author": {
    "name": "Spear AI",
    "email": "org@spear.ai",
    "url": "https://spear.ai"
  },
  "type": "module",
  "dependencies": {
    "@graphql-eslint/eslint-plugin": "^3.20.1",
    "@next/eslint-plugin-next": "^14.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^18.3.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-formatjs": "^6.4.6",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-json-schema-validator": "^5.1.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-markdown": "^5.0.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-use-props": "^1.0.0",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-toml": "^0.11.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-yml": "^1.14.0",
    "globals": "^15.3.0",
    "jsonc-eslint-parser": "^2.4.0",
    "toml-eslint-parser": "^0.9.3",
    "typescript-eslint": "^8.56.0",
    "yaml-eslint-parser": "^1.2.2"
  },
  "devDependencies": {
    "eslint": "10.2.1",
    "graphql": "16.8.1",
    "npm-package-json-lint": "7.1.0",
    "prettier": "3.5.3",
    "react": "18.3.1",
    "tsup": "8.0.2",
    "typescript": "5.4.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "graphql": ">=15.8.0 <17",
    "react": "^18.2.0",
    "typescript": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "directory": "packages/eslint-config",
    "url": "https://github.com/spear-ai/citizen.git"
  },
  "scripts": {
    "build": "tsup src --clean --dts --format cjs,esm",
    "dev": "yarn build --watch",
    "eslint:check": "eslint --max-warnings 0 .",
    "eslint:fix": "yarn eslint:check --fix",
    "npmpkgjsonlint:check": "npmPkgJsonLint .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typescript:check": "tsc --noEmit"
  },
  "types": "./dist/index.d.ts"
}
