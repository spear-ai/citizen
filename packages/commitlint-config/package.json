{
  "name": "@spear-ai/commitlint-config",
  "version": "3.2.1",
  "description": "Spear AI commitlint config",
  "license": "MIT",
  "author": {
    "name": "Spear AI",
    "email": "org@spear.ai",
    "url": "https://spear.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spear-ai/citizen.git",
    "directory": "packages/commitlint-config"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src --cjsInterop --clean --dts --format cjs,esm --splitting",
    "dev": "pnpm run build --watch & pnpm run test:dev",
    "npmpkgjsonlint:check": "npmPkgJsonLint .",
    "test": "vitest run",
    "test:dev": "vitest watch"
  },
  "devDependencies": {
    "@commitlint/types": "19.0.3",
    "@spear-ai/npm-package-json-lint-config": "workspace:*",
    "@spear-ai/tsconfig": "workspace:*",
    "commitlint": "19.3.0",
    "npm-package-json-lint": "catalog:shared-dev",
    "tsup": "catalog:shared-dev",
    "typescript": "catalog:shared-dev",
    "vitest": "catalog:shared-dev"
  },
  "peerDependencies": {
    "commitlint": "^19.3.0"
  }
}
