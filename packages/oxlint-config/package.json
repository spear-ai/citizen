{
  "name": "@spear-ai/oxlint-config",
  "version": "0.0.0",
  "description": "Spear AI Oxlint config",
  "license": "MIT",
  "author": {
    "name": "Spear AI",
    "email": "org@spear.ai",
    "url": "https://spear.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spear-ai/citizen.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/next-intl": {
      "types": "./dist/plugins/next-intl.d.ts",
      "import": "./dist/plugins/next-intl.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/plugins/next-intl.ts --clean --dts --format esm --target node20",
    "dev": "pnpm run build --watch",
    "npmpkgjsonlint:check": "npmPkgJsonLint ."
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.6.0",
    "@oxlint/plugins": "1.58.0",
    "@stylistic/eslint-plugin": "5.8.0",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-canonical": "5.1.3",
    "eslint-plugin-formatjs": "6.1.4",
    "eslint-plugin-json-schema-validator": "6.0.3",
    "eslint-plugin-regexp": "3.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-typescript-sort-keys": "3.3.0"
  },
  "devDependencies": {
    "@spear-ai/npm-package-json-lint-config": "workspace:*",
    "@spear-ai/tsconfig": "workspace:*",
    "@types/node": "20.12.12",
    "npm-package-json-lint": "catalog:shared-dev",
    "oxlint": "catalog:shared-dev",
    "tsup": "catalog:shared-dev",
    "typescript": "catalog:shared-dev"
  },
  "peerDependencies": {
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": ">=0.22.1"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
